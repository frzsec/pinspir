# Finspire Environment Variables Template
NODE_ENV=development

# Database Connection (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/finspire_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/finspire_test

# Connection Pool Settings (Single-VPS Safe)
DATABASE_MAX_CONNECTIONS=20
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Server URL & Auth Configuration (Phase 04)
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=finspire_dev_secret_change_me_in_production_min32chars
BETTER_AUTH_URL=http://localhost:3000
